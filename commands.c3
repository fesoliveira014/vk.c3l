VK_extension_bindings extensions;

fn void load_extensions(Instance instance) {
   extensions.vkResetQueryPoolEXT = (PFN_vkResetQueryPoolEXT)get_instance_proc_addr(instance,"vkResetQueryPoolEXT");
   extensions.vkCreatePipelineBinariesKHR = (PFN_vkCreatePipelineBinariesKHR)get_instance_proc_addr(instance,"vkCreatePipelineBinariesKHR");
   extensions.vkDestroyPipelineBinaryKHR = (PFN_vkDestroyPipelineBinaryKHR)get_instance_proc_addr(instance,"vkDestroyPipelineBinaryKHR");
   extensions.vkGetPipelineKeyKHR = (PFN_vkGetPipelineKeyKHR)get_instance_proc_addr(instance,"vkGetPipelineKeyKHR");
   extensions.vkGetPipelineBinaryDataKHR = (PFN_vkGetPipelineBinaryDataKHR)get_instance_proc_addr(instance,"vkGetPipelineBinaryDataKHR");
